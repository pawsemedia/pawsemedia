---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="about — pawse media">
  <section style="padding-top: 32px; position: relative;">
    <span class="bumper bumper--mono" style="top: 28px; right: 4px; transform: rotate(2deg); font-size: 9px;">who?</span>
    <h1 style="font-size: 24px; font-weight: 500; letter-spacing: 3px; margin-bottom: 20px;">about</h1>

    <div class="card">
      <div style="margin-bottom: 12px;">
        <div style="font-size: 16px; font-weight: 500; color: #fff;">pawse media</div>
        <div style="font-size: 11px; color: rgba(255,255,255,0.25);">est. 2026</div>
      </div>
      <p id="about-text" style="font-size: 14px; line-height: 1.7; color: rgba(255,255,255,0.5);">
        this is pawse media. a spot for posts, cool finds, videos, music, and whatever else.
        run by me and my friends. that's about it.
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function() {
    try {
      var text = JSON.parse(localStorage.getItem('pawse_about'));
      if (text) document.getElementById('about-text').textContent = text;
    } catch(e) {}
  })();
</script>
