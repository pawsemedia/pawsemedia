---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="pics — the corner — pawse media">
  <section style="padding-top: 32px; position: relative;">
    <span class="bumper bumper--impact" style="top: 28px; right: 4px; transform: rotate(-2deg); font-size: 12px;">LOOK</span>
    <div style="margin-bottom: 16px;">
      <a href="/corner" style="font-size: 11px; color: rgba(255,255,255,0.3); letter-spacing: 1px;">← the corner</a>
    </div>
    <h1 style="font-size: 28px; font-weight: 700; letter-spacing: 3px; margin-bottom: 20px;">pics</h1>
    <div id="pics-grid" class="pics-grid">
      <div style="font-size: 13px; color: rgba(255,255,255,0.3);">loading pics...</div>
    </div>
  </section>
</BaseLayout>

<style>
  .pics-grid {
    columns: 3;
    column-gap: 8px;
  }

  .pics-grid > * {
    display: inline-block;
    width: 100%;
    margin-bottom: 8px;
    break-inside: avoid;
  }

  @media (max-width: 640px) {
    .pics-grid { columns: 2; }
  }

  @media (max-width: 380px) {
    .pics-grid { columns: 1; }
  }
</style>

<script is:inline>
  (function() {
    pawseApi.get('corner_items').then(function(items) {
      items = items || [];
      var pics = items.filter(function(i) { return i.type === 'image' || i.type === 'link-pics' || i.type === 'instagram-pics'; });
      var grid = document.getElementById('pics-grid');
      if (pics.length === 0) {
        grid.innerHTML = '<div style="font-size:13px;color:rgba(255,255,255,0.3);grid-column:1/-1;">no pics yet — add some from the admin panel</div>';
        return;
      }
      grid.innerHTML = pics.map(function(p) {
        if (p.type === 'image') {
          return '<a href="' + p.url + '" target="_blank" style="display:block;border-radius:8px;overflow:hidden;border:1px solid rgba(255,255,255,0.08);transition:border-color 0.2s;">' +
            '<img src="' + p.url + '" alt="' + p.title + '" style="width:100%;height:auto;display:block;" />' +
            '</a>';
        } else if (p.type === 'instagram-pics') {
          var igMatch = p.url.match(/instagram\.com\/(p|reel)\/([^/?]+)/);
          if (igMatch) {
            return '<div class="card" style="overflow:hidden;"><div style="min-height:400px;"><iframe src="https://www.instagram.com/' + igMatch[1] + '/' + igMatch[2] + '/embed/" style="width:100%;min-height:400px;border:none;" allowfullscreen></iframe></div>' +
              '<div style="padding:8px 12px;font-size:12px;font-weight:600;color:#fff;">' + p.title + '</div></div>';
          }
          return '<a href="' + p.url + '" target="_blank" class="card" style="display:flex;align-items:center;justify-content:center;padding:40px 12px;text-decoration:none;">' +
            '<div style="text-align:center;"><div style="font-size:13px;font-weight:600;color:#fff;">' + p.title + '</div><div style="font-size:10px;color:rgba(255,255,255,0.3);margin-top:4px;">open on instagram ↗</div></div></a>';
        } else {
          return '<a href="' + p.url + '" target="_blank" class="card" style="display:flex;align-items:center;justify-content:center;padding:40px 12px;text-decoration:none;">' +
            '<div style="text-align:center;">' +
            '<div style="font-size:13px;font-weight:600;color:#fff;">' + p.title + '</div>' +
            '<div style="font-size:10px;color:rgba(255,255,255,0.3);margin-top:4px;">open link ↗</div>' +
            '</div></a>';
        }
      }).join('');
    });
  })();
</script>
