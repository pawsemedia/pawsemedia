---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="pics — the corner — pawse media">
  <section style="padding-top: 32px; position: relative;">
    <span class="bumper bumper--impact" style="top: 28px; right: 4px; transform: rotate(-2deg); font-size: 12px;">LOOK</span>
    <div style="margin-bottom: 16px;">
      <a href="/corner" style="font-size: 11px; color: rgba(255,255,255,0.3); letter-spacing: 1px;">← the corner</a>
    </div>
    <h1 style="font-size: 28px; font-weight: 700; letter-spacing: 3px; margin-bottom: 20px;">pics</h1>
    <div id="pics-grid" class="pics-grid">
      <div style="font-size: 13px; color: rgba(255,255,255,0.3);">loading pics...</div>
    </div>
  </section>
</BaseLayout>

<style>
  .pics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  @media (max-width: 480px) {
    .pics-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script is:inline>
  (function() {
    var items = [];
    try { items = JSON.parse(localStorage.getItem('pawse_corner_items')) || []; } catch(e) {}
    var pics = items.filter(function(i) { return i.type === 'image'; });
    var grid = document.getElementById('pics-grid');
    if (pics.length === 0) {
      grid.innerHTML = '<div style="font-size:13px;color:rgba(255,255,255,0.3);grid-column:1/-1;">no pics yet — add some from the admin panel</div>';
      return;
    }
    grid.innerHTML = pics.map(function(p) {
      return '<a href="' + p.url + '" target="_blank" style="display:block;aspect-ratio:1;border-radius:8px;overflow:hidden;border:1px solid rgba(255,255,255,0.08);transition:border-color 0.2s;">' +
        '<img src="' + p.url + '" alt="' + p.title + '" style="width:100%;height:100%;object-fit:cover;" />' +
        '</a>';
    }).join('');
  })();
</script>
