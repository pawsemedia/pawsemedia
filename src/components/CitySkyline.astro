<div class="city">
  <div class="city__track">
    <div class="city__half"><img src="/vectors/skyline.png" alt="" /></div>
    <div class="city__half"><img src="/vectors/skyline.png" alt="" /></div>
  </div>
</div>

<style>
  .city {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100px;
    z-index: 1;
    overflow: hidden;
    pointer-events: all;
    cursor: pointer;
  }

  .city__track {
    display: flex;
    width: 200%;
    height: 100%;
    animation: cscroll 60s linear infinite;
  }

  .city__half {
    width: 50%;
    height: 100%;
    flex-shrink: 0;
  }

  .city__half img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: fill;
    opacity: 0.05;
    transition: opacity 0.3s, transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
    transform-origin: bottom center;
  }

  .city:hover .city__half img {
    opacity: 0.09;
    transform: scaleY(1.08);
  }

  @keyframes cscroll {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
</style>

<script is:inline>
  (function() {
    var track = document.querySelector('.city__track');
    if (!track) return;
    var cur = 60, target = 60;
    var orig = window.pawseSetMusicEnergy;
    window.pawseSetMusicEnergy = function(v) {
      if (orig) orig(v);
      target = v > 0 ? 35 : 60;
    };
    (function tween() {
      cur += (target - cur) * 0.02;
      track.style.animationDuration = cur.toFixed(1) + 's';
      requestAnimationFrame(tween);
    })();
  })();
</script>
