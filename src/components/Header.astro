---
const currentPath = Astro.url.pathname;
const navItems = [
  { label: 'home', href: '/' },
  { label: 'posts', href: '/posts' },
  { label: 'corner', href: '/corner' },
  { label: 'about', href: '/about' },
];
---

<header class="header">
  <div class="header__bar">
    <a href="/" class="header__brand">
      <img src="/logo-white.png" alt="" class="header__logo" />
      <span class="header__name">pawse media</span>
    </a>
    <nav class="header__tabs">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['header__tab', { 'header__tab--active': currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
  <div class="header__ticker">
    <div class="header__ticker-track" id="ticker-track"></div>
  </div>
</header>

<style>
  .header { position: sticky; top: 0; z-index: 50; }

  .header__bar {
    background: linear-gradient(180deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.03) 100%);
    border-bottom: 2px solid rgba(255,255,255,0.08);
    padding: 0 24px;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header__brand { display: flex; align-items: center; gap: 8px; text-decoration: none; padding: 8px 0; }
  .header__logo { width: 28px; height: 28px; object-fit: contain; }
  .header__name { font-size: 18px; font-weight: 600; letter-spacing: 4px; color: #fff; text-transform: lowercase; }

  .header__tabs { display: flex; align-items: stretch; }
  .header__tab {
    padding: 10px 18px; font-size: 12px; font-weight: 600; letter-spacing: 1.5px;
    text-transform: uppercase; color: rgba(255,255,255,0.45); text-decoration: none;
    border-left: 1px solid rgba(255,255,255,0.05); display: flex; align-items: center;
    transition: all 0.2s cubic-bezier(0.34,1.56,0.64,1); position: relative;
  }
  .header__tab:last-child { border-right: 1px solid rgba(255,255,255,0.05); }
  .header__tab--active {
    color: #fff;
    background: linear-gradient(180deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.04) 100%);
    box-shadow: inset 0 2px 0 rgba(255,255,255,0.15);
  }
  .header__tab--active::after {
    content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: rgba(255,255,255,0.3);
  }
  .header__tab:hover:not(.header__tab--active) { color: rgba(255,255,255,0.8); background: rgba(255,255,255,0.04); }

  .header__ticker {
    background: rgba(255,255,255,0.03);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    overflow: hidden;
    height: 20px;
  }

  .header__ticker-track {
    display: flex;
    align-items: center;
    height: 100%;
    white-space: nowrap;
    font-size: 9px;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.15);
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .header__name { font-size: 14px; letter-spacing: 2px; }
    .header__tab { padding: 8px 12px; font-size: 10px; }
    .header__logo { width: 22px; height: 22px; }
  }
</style>

<script is:inline>
  (function() {
    var track = document.getElementById('ticker-track');
    if (!track) return;

    var text = 'welcome to pawse media ★ posts ★ videos ★ pics ★ music ★ ';
    (async function() {
      try {
        var custom = await pawseApi.get('ticker');
        if (custom && custom.length > 0) text = custom + ' ★ ';
      } catch(e) {
        try {
          var local = JSON.parse(localStorage.getItem('pawse_ticker'));
          if (local && local.length > 0) text = local + ' ★ ';
        } catch(e2) {}
      }
      buildTicker();
    })();

    function buildTicker() {
      var test = document.createElement('span');
      test.style.cssText = 'font-size:9px;letter-spacing:2px;text-transform:uppercase;visibility:hidden;position:absolute;white-space:nowrap;';
      test.textContent = text;
      document.body.appendChild(test);

      requestAnimationFrame(function() {
        var oneWidth = test.offsetWidth || 200;
        document.body.removeChild(test);

        var screenW = window.innerWidth;
        var reps = Math.ceil(screenW / oneWidth) + 2;
        var segment = '';
        for (var i = 0; i < reps; i++) segment += text;

        track.textContent = segment + segment;

        var totalHalf = oneWidth * reps;
        var pos = 0;
        var speed = 0.6;

        function tick() {
          pos -= speed;
          if (pos <= -totalHalf) pos += totalHalf;
          track.style.transform = 'translateX(' + pos.toFixed(1) + 'px)';
          requestAnimationFrame(tick);
        }
        tick();
      });
    }

    // start with default text immediately, API will rebuild if custom
    buildTicker();
  })();
</script>
